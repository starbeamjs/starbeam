---
import "@fontsource/geist-sans";
import "@starbeam-demos/table-react/src/styles.css";

import PreactInventoryDemo from "../../components/PreactInventoryDemo";
import ReactInventoryDemo from "../../components/ReactInventoryDemo";
import StarMark from "../../components/StarMark.astro";
import "../../styles/tokens.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Inventory table demo · Starbeam</title>
    <meta
      name="description"
      content="A Starbeam inventory table demo embedded in the docs with React and Preact shells."
    />
  </head>
  <body>
    <header class="docs-demo-topbar">
      <a class="docs-demo-brand" href="/" aria-label="Starbeam home">
        <StarMark class="docs-demo-brand__mark" />
        <span>Starbeam</span>
      </a>
      <nav aria-label="Demo navigation">
        <a href="/start/introduction/">Docs</a>
        <a href="/frameworks/overview/">Frameworks</a>
        <a href="https://github.com/starbeamjs/starbeam/tree/main/demos">
          Source
        </a>
      </nav>
    </header>

    <section class="docs-demo-intro" aria-labelledby="demo-heading">
      <p class="docs-demo-label">Embedded demos</p>
      <h1 id="demo-heading">One table model, multiple framework edges.</h1>
      <p>
        Both demos below use the same framework-neutral
        <code>@starbeam-demos/table-core</code> inventory model. The React shell
        uses <code>useReactive()</code>; the Preact shell installs the adapter
        once and reads the same model directly during render.
      </p>
    </section>

    <section class="docs-demo-section" aria-labelledby="react-demo-heading">
      <div class="docs-demo-heading-row">
        <div>
          <p class="docs-demo-label">React</p>
          <h2 id="react-demo-heading">React shell</h2>
        </div>
        <a
          class="docs-demo-link"
          href="https://github.com/starbeamjs/starbeam/tree/main/demos/table-react"
        >
          View source
        </a>
      </div>
      <ReactInventoryDemo client:only="react" />
    </section>

    <section class="docs-demo-section" aria-labelledby="preact-demo-heading">
      <div class="docs-demo-heading-row">
        <div>
          <p class="docs-demo-label">Preact</p>
          <h2 id="preact-demo-heading">Preact shell</h2>
        </div>
        <a
          class="docs-demo-link"
          href="https://github.com/starbeamjs/starbeam/tree/main/demos/table-preact"
        >
          View source
        </a>
      </div>
      <PreactInventoryDemo client:only="preact" />
    </section>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  .docs-demo-topbar,
  .docs-demo-intro,
  .docs-demo-section {
    margin-inline: auto;
    width: min(88rem, calc(100vw - clamp(2rem, 5vw, 4rem)));
  }

  .docs-demo-topbar {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-block: clamp(1rem, 3vw, 1.6rem) 0;
  }

  .docs-demo-brand {
    align-items: center;
    color: var(--ink);
    display: inline-flex;
    font-size: 0.95rem;
    font-weight: 900;
    gap: 0.75rem;
    letter-spacing: 0.34em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .docs-demo-brand__mark {
    --star-mark-size: 2.35rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  nav a,
  .docs-demo-link {
    color: var(--green);
    font-weight: 760;
    text-decoration: none;
  }

  nav a:hover,
  .docs-demo-link:hover {
    color: var(--green-dark);
  }

  .docs-demo-intro {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .docs-demo-label {
    color: var(--green);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  h1 {
    color: var(--ink);
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia,
      serif;
    font-size: clamp(3.2rem, 7vw, 6.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin: 0;
    max-width: 12ch;
  }

  .docs-demo-intro p:last-child {
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.7;
    margin-block: 1.4rem 0;
    max-width: 50rem;
  }

  code {
    background: rgba(255, 250, 241, 0.82);
    border: 1px solid var(--line);
    border-radius: var(--radius-tight);
    color: var(--green-dark);
    padding: 0.1rem 0.24rem;
  }

  .docs-demo-section {
    padding-block-end: clamp(3rem, 6vw, 5rem);
  }

  .docs-demo-heading-row {
    align-items: end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-block-end: 1rem;
  }

  h2 {
    color: var(--ink);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .docs-demo-section :global(.shell) {
    margin-inline: 0;
    max-width: none;
    padding: 0;
  }

  @media (max-width: 760px) {
    .docs-demo-topbar,
    .docs-demo-heading-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>